class Types {
    public int $i = 10;
    public float $f = 2.5;
    public bool $b = true;
    public string $s = "str";
    private int $hidden = 99;
    public function reveal() { return $this->hidden; }
    public function setAll(int $i, float $f, string $s) {
        $this->i = $i;
        $this->f = $f;
        $this->s = $s;
    }
}
var t = new Types();
println(t->i, t->f, t->b, t->s, t->reveal());
t->setAll(20, 4.5, "new");
println(t->i, t->f, t->s);
