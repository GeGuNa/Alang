var q = function () { println("called"); };
q();
var add2 = function (int a, int b) { return a + b; };
println(add2(3, 4));
var makeAdder = function (int n) {
    return function (int x) { return x + n; };
};
var add3 = makeAdder(3);
println(add3(4));
function triple(int n) { return n * 3; }
var f = triple;
println(f(7));
