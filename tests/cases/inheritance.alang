class Animal {
    protected $name = "animal";
    const KINGDOM = "animalia";
    function __construct($name) { $this->name = $name; }
    function speak() { return "..."; }
    function getName() { return $this->name; }
}
class Dog extends Animal {
    function speak() { return "woof"; }
    function parentSpeak() { return parent::speak(); }
}
class Cat : public Animal {
    function speak() { return "meow"; }
}
class Bird extend Animal {}
var d = new Dog("rex");
println(d->getName(), d->speak(), d->parentSpeak(), Dog::KINGDOM);
var c = new Cat("tom");
println(c->getName(), c->speak());
var b = new Bird("tweety");
println(b->getName());
