function f1(int a, $b, int c) { return a + $b + c; }
function f2($x, string $y) { return $y . $x; }
function f3() { return "none"; }
function f4(int a, int b, int c, int d, int e, int f, int g) { return a+b+c+d+e+f+g; }
println(f1(1, 2, 3));
println(f2(5, "v="));
println(f3());
println(f4(1,2,3,4,5,6,7));
