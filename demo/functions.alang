println("functions with parameters and return values");

int add(int a, int b) {
    return a + b;
}

int fact(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

void greet(string name) {
    println("hello", name);
    return;
}

int max(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}

println("add(7, 8) =", add(7, 8));
println("fact(6) =", fact(6));
println("max(4, 9) =", max(4, 9));
greet("world");
