println("concurrency stress and isolation");

int shared_value = 0;

function increment() {
    shared_value = shared_value + 1;
    return shared_value;
}

println("parent before", shared_value);
var t = new Thread(increment);
t->start();
println("worker saw", t->join());
println("parent after", shared_value);

function calculate(int seed) {
    int total = seed;
    for (int i = 0; i < 50000; i = i + 1) {
        total = total + i;
    }
    return total;
}

var a = new Thread(calculate);
var b = new Thread(calculate);
var c = new Thread(calculate);
a->start(1);
b->start(2);
c->start(3);
println(a->join(), b->join(), c->join());

async function task(int n) {
    return n * 3;
}
var f1 = task(7);
var f2 = task(8);
println(await f1, await f2);
println("final parent value", shared_value);
