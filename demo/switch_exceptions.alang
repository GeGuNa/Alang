println("switch");
var code = 2;
switch (code) {
    case 1: println("one"); break;
    case 2: println("two");
    case 3: println("three"); break;
    default: println("other");
}

println("exceptions");
function divide(int a, int b) {
    if (b == 0) { throw "division by zero"; }
    return a / b;
}
try {
    println(divide(10, 2));
    println(divide(10, 0));
} catch (e) {
    println("caught:", e);
} finally {
    println("cleanup");
}
println("done");
